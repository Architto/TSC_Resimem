# Physical GPU index used by nvidia-smi.
RESIMEM_NVIDIA_SMI_INDEX=0

# Operation-span profiling is disabled by default. Set an output file when enabled.
RESIMEM_PROFILE_OPS=0
RESIMEM_PROFILE_JSONL=
RESIMEM_PROFILE_RUN_ID=
RESIMEM_PROFILE_REPEAT_ID=
RESIMEM_PROFILE_CUDA_SYNC=0
RESIMEM_PROFILE_CUDA_EVENT=0
